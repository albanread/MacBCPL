// SWIs -- RISC OS from BCPL: by number and by name, registers in and out,
// the X form's error, a vector as a buffer
LET START() BE $(
    LET r = VEC 9
    LET buf = GETVEC(32)
    LET e = 0
    r!0 := "OS_Write0 says hello*N"
    SYS(#X02, r)                            // OS_Write0 by number
    SYSN("OS_ReadMonotonicTime", r)         // by name
    WRITEF("The box has been up %d seconds*N", r!0 / 100)
    // OS_ReadVarVal into a buffer the program made
    r!0 := "Sys$Time"; r!1 := buf; r!2 := 255; r!3 := 0; r!4 := 3
    IF XSYSN("OS_ReadVarVal", r) = 0 DO $(
        buf%(r!2) := 0
        WRITES("Sys$Time is "); WRITES(CSTR(buf)); NEWLINE()
    $)
    // an error comes back from the X form, with V set
    r!0 := "NotACommand"
    e := XSYSN("OS_CLI", r)
    WRITEF("XOS_CLI gave error &%x (flags %d): ", ERRNUM(e), SYSFLAGS())
    WRITES(ERRTEXT(e)); NEWLINE()
    WRITEF("riscos_time() = %d cs*N", riscos_time())
    FREEVEC(buf)
$)
